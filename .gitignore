# Quarto
/_site/
/.quarto/
*_files/
*.html.md

# generated build artifacts — regenerate with the scripts, don't commit
/quizzes/build/
/d2l/build/

# python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
uv.lock.bak

# MODFLOW binaries, downloaded by postbuild.sh
/modflow/

# model run outputs
*.hds
*.cbc
*.list
*.ddn

# os cruft
.DS_Store
Thumbs.db

# Word lock files
~$*

# generated by scripts/fill_solutions.py — the source of truth is the
# `solutions:` block in each lab notebook's metadata, not these files
/labs/*/_solutions/

# scratch directories for MODFLOW runs, incl. figures built at render time
/_run/

# pytest
.pytest_cache/

# Quarto vendors JS libs in here too; only the execute-results and figures
# need committing, and site_libs is 5 MB it can regenerate.
/_freeze/site_libs/
